{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteDecision",
  "description": "跨 Harness 统一路由判定决策对象 (解耦高召回候选集与高精度推荐装配)",
  "type": "object",
  "required": ["domain", "confidence", "candidates", "active_recipe", "action", "side_effects", "must_not", "reasons"],
  "properties": {
    "domain": {
      "type": "string",
      "enum": ["testing", "reverse", "ui", "protocol", "mixed", "none"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "none"]
    },
    "candidates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "高召回候选集: 涵盖该领域及跨领域的完整技能包供给清单，供模型充分决策"
    },
    "active_recipe": {
      "type": "object",
      "required": ["name", "skills"],
      "properties": {
        "name": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "description": "高精度默认装配: compose 标准组合建议"
    },
    "action": {
      "type": "string",
      "enum": ["dispatch", "handoff", "ask"],
      "description": "建议适配器动作"
    },
    "side_effects": {
      "type": "string",
      "const": "none",
      "description": "内核恒定零副作用"
    },
    "must_not": {
      "type": "array",
      "items": { "type": "string" },
      "description": "明确的副作用禁止清单 (如 initReverseCase, create_work_dir)"
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "决策判定依据链"
    }
  },
  "additionalProperties": false
}
