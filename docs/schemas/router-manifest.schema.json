{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouterManifest",
  "description": "Curated domains and recipes with registry-backed, build-time availability",
  "type": "object",
  "required": ["version", "domains", "recipes", "availability"],
  "properties": {
    "version": { "const": "2.0.0" },
    "generatedAt": { "type": "string" },
    "availability": {
      "type": "object",
      "additionalProperties": { "enum": ["ready", "disabled", "missing", "invalid", "unregistered"] }
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "skills", "triggers", "negatives"],
        "properties": {
          "description": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "triggers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "negatives": {
            "type": "array",
            "items": { "type": "string" }
          },
          "defaultRecipe": { "type": "string" },
          "skillTriggers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["domain", "description", "skills"],
        "properties": {
          "domain": { "type": "string" },
          "description": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
